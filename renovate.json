{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "separateMinorPatch": true
    },
    {
      "description": "Automerge low-risk container image updates after CI passes.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": true,
      "labels": ["renovate", "automerge"]
    },
    {
      "description": "Automerge patch-level Helm chart updates after CI passes.",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "labels": ["renovate", "helm", "automerge"]
    },
    {
      "description": "Keep kube-prometheus-stack updates manual because monitoring upgrades can pass CI but fail at runtime.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "labels": ["renovate", "helm", "manual-approval"]
    },
    {
      "description": "Require manual approval for higher-risk Helm chart changes.",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "labels": ["renovate", "helm", "manual-approval"]
    }
  ],
  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/apps/.*/values\\.yaml$/", "/infrastructure/.*/values\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n.*?tag:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/images/devpod/Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>[^\\s]+)\\s+extractVersion=(?<extractVersion>[^\\s]+)\\nARG\\s+[A-Z_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the pinned Home Assistant init-container Alpine image.",
      "managerFilePatterns": ["/apps/homelab/home-assistant/values\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=docker\\s+depName=alpine\\s*\\n\\s*image:\\s*alpine:(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned HACS release downloaded by Home Assistant.",
      "managerFilePatterns": ["/apps/homelab/home-assistant/values\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=hacs/integration\\s*\\n\\s*wget\\s+-O\\s+/tmp/hacs\\.zip\\s+https://github\\.com/hacs/integration/releases/download/(?<currentValue>[^/\\s]+)/hacs\\.zip"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hacs/integration",
      "versioningTemplate": "semver"
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0
}
